DISCORD_TOKEN=ใส่โทเคนบอทที่นี่
GUILD_ID=ใส่ไอดีเซิร์ฟเวอร์ (ไม่ใส่ก็ได้ แต่คำสั่งจะขึ้นช้าถึง 1 ชม.)
DB_PATH=records.db
PIP_SIZE=0.1
WEBHOOK_SECRET=ตั้งรหัสลับยาวๆ (ไม่ใส่ = ปิดระบบรับสัญญาณ TradingView)
PORT=8080
NEWS_CURRENCIES=USD
NEWS_IMPACT=High
NEWS_LEAD=30
NEWS_BLACKOUT=30
LEADERBOARD_MIN_TRADES=5
PUBLIC_LANG=both
DEFAULT_LANG=both
# --- เว็บลงทะเบียนเรียนเทรด (registration/) ---
REG_ADMIN_TOKEN=ตั้งรหัสแอดมินยาวๆ สำหรับเข้า /admin
REG_DISCORD_WEBHOOK=URL webhook ของห้อง Discord ที่จะให้แจ้งเตือนคนลงทะเบียนใหม่ (ไม่ใส่ก็ได้)
